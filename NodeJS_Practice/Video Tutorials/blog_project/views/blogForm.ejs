<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Blog</title>
  </head>
  <body>
    <h1>Create Blogs</h1>
    <form action="/blogs/createBlog" method="post">
      <label>Title: </label>
      <input
        type="text"
        required
        name="title"
        placeholder="how to win in chess"
      />
      <br />
      <label>Content: </label>
      <br />
      <textarea
        rows="15"
        cols="50"
        name="content"
        required
        placeholder="enter your content here"
      ></textarea>
      <br />
      <button type="submit">Create Post</button>
    </form>
  </body>
</html>
