<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SignUp</title>
</head>
<body>
        <h1>Signup</h1>
    <form action="/" method="post">
        <label>Name: </label>
        <input type="text" required placeholder="ex. john" name="name">
        <label>Email</label>
        <input type="email" required placeholder="ex. john@example.com" name="email">
        <label>Password</label>
        <input type="password" required name="password">
        <button type="submit">Sign up</button>
    </form>
</body>
</html>