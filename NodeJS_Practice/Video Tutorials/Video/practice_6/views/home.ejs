<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home</title>
  </head>
  <body>
    <form action="/url" method="post">
        <label>Enter URL: </label>
        <input type="text" requried placeholder="https://google.com" name="url">
        <button type="submit">Submit</button>
    </form>
    <% if (urls) { %>
     <% urls.forEach(element => { %>
      <p>Original URL: <%= element.originalUrl  %> </p>
      <p>Short URL: http://localhost:8000/url/<%= element.shortUrl  %></p>
      <p>Clicks: <%= element.clicks  %></p>
     <% }) %>
    <% } %>
     
  </body>
</html>
