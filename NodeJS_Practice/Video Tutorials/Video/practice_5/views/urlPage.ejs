<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL SHORTNER</title>
</head>
<body>
    <h1>URL SHORTNER</h1>
    <br>
    <form action="/" method="post">
        <label>Enter URL: </label>
        <input type="text" required placeholder="https://google.com" name="originalUrl">
        <button type="submit">Submit</button>
    </form>
    <% if (typeof links !== 'undefined' && links && links.length > 0) { %> 
  <ul> 
    <% links.forEach(obj => { %> 
      <li> 
        <p>Original URL: <%=obj.originalUrl%></p> 
        <p>Short URL: <%= obj.shortUrl %></p>
        Clicks: <%= obj.clicks %> 
      </li> 
    <% }) %> 
  </ul> 
<% } %>
</body>
</html>